__pycache__/
*.py[cod]
.DS_Store

# ERP CSV export (host-visible on purpose; the file itself is runtime output, not source)
/exports/*.csv

# Node-RED runtime state — only flows.json (the flow itself) is tracked
/nodered_data/*
!/nodered_data/flows.json

# MQTT Explorer's runtime state — only the seeded settings.json (Waffle Line 01 connection) is tracked
/mqtt_explorer_data/*
!/mqtt_explorer_data/.gitkeep
!/mqtt_explorer_data/settings.json

# Mosquitto's persistence file (retained messages) — runtime state, not source
/mosquitto/data/*
!/mosquitto/data/.gitkeep
